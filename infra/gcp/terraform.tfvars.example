project_id = "wine-in-a-million-501121"
region     = "us-central1"
name       = "wine-in-a-million"

# First apply with deploy_backend=false to create GCS + Artifact Registry.
# After building/pushing the backend image, set deploy_backend=true and set backend_image.
deploy_backend = false
backend_image  = ""

# Upload the wine CSV to the dataset bucket, then set this for the ingest job:
# ingest_csv_uri = "gs://wine-in-a-million-501121-wine-in-a-million-datasets/winemag-data-130k-v2.csv"

# With the Cloudflare Worker proxy, browsers normally do same-origin /api calls.
# Keep this strict only if you also expose the Cloud Run API directly to browsers.
cors_origins = "*"

# Set to 1 if you want to avoid model-download cold starts.
backend_min_instances = 0

# Required streaming LLM recommendations:
llm_model          = "gpt-4o-mini"
llm_api_key_secret = "wine-llm-api-key"
