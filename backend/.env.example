# --- Vector store -----------------------------------------------------------
# Local development (LanceDB writes Lance files to disk):
LANCEDB_URI=./data/lancedb

# MinIO / S3 (LanceDB writes Lance files into the bucket):
# LANCEDB_URI=s3://wine/lancedb
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_ENDPOINT=http://localhost:9000
# AWS_REGION=us-east-1
# AWS_ALLOW_HTTP=true

# Google Cloud Storage:
# LANCEDB_URI=gs://wine-bucket/lancedb
# GOOGLE_SERVICE_ACCOUNT=/secrets/sa.json

LANCEDB_TABLE=wines

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Optional LLM explanation layer ------------------------------------------
LLM_ENABLED=false
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible endpoint (Groq, Together, Ollama, vLLM):
# LLM_BASE_URL=https://api.openai.com/v1

# --- API ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
DEFAULT_K=5
